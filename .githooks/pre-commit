#!/bin/sh
set -eu

root=$(git rev-parse --show-toplevel)

if git diff --cached --name-only | grep -Eq '^(scripts/|tests/|install.sh|plugins/skill-manager/)'; then
  (
    cd "$root"
    python3 -m unittest discover -s tests
    uv run ruff check scripts tests
    uv run ruff format --check scripts tests
  )
fi

if git diff --cached --name-only | grep -q '^plugins/skill-manager/'; then
  (
    cd "$root/plugins/skill-manager"
    bun run check
  )
fi

if git diff --cached --name-only | grep -q '^extensions/cliproxyapi/'; then
  cd "$(git rev-parse --show-toplevel)/extensions/cliproxyapi"
  bun run typecheck
  bun run lint
  bun run format:check
  bun run test
fi
